  runStatus: string;
  tests?: MockE2eTest[];
}

/**
 * Mock VS Code APIs
 */
export class MockVSCodeWindow {
  private inputBoxResponses: Map<string, string> = new Map();
  private quickPickResponses: Map<string, any> = new Map();

  showInputBox = jest.fn().mockImplementation(async (options: vscode.InputBoxOptions) => {
    const key = options.prompt || 'default';
    return this.inputBoxResponses.get(key) || options.value || '';
  });

  showQuickPick = jest.fn().mockImplementation(async (items: any[], options?: vscode.QuickPickOptions) => {
    const key = options?.placeHolder || 'default';
    return this.quickPickResponses.get(key) || (Array.isArray(items) ? items[0] : undefined);
  });

  showInformationMessage = jest.fn().mockResolvedValue(undefined);
  showWarningMessage = jest.fn().mockResolvedValue(undefined);
  showErrorMessage = jest.fn().mockResolvedValue(undefined);
  setStatusBarMessage = jest.fn().mockReturnValue({ dispose: jest.fn() });

  get activeTextEditor() {
    return {
      document: {
        uri: {
          fsPath: '/mock/workspace/test.ts'
        }
      }
    };
  }

  // Helper methods for tests
  setInputBoxResponse(prompt: string, response: string) {
    this.inputBoxResponses.set(prompt, response);
  }

  setQuickPickResponse(placeholder: string, response: any) {
    this.quickPickResponses.set(placeholder, response);
  }

  clearResponses() {
    this.inputBoxResponses.clear();
    this.quickPickResponses.clear();
  }
}

