/**
 * Test Command Executor
 * Simulates VS Code command execution for testing
 */
export class TestCommandExecutor {
  private commands: Map<string, Function> = new Map();
  private mockWindow: MockVSCodeWindow;
  private mockClient: MockDebuggAIServerClient;
  private mockIDE: MockIDE;
  private mockConfigHandler: MockConfigHandler;

  constructor() {
    this.mockWindow = new MockVSCodeWindow();
    this.mockClient = new MockDebuggAIServerClient();
    this.mockIDE = new MockIDE();
    this.mockConfigHandler = new MockConfigHandler();
  }

  registerCommand(commandId: string, handler: Function) {
    this.commands.set(commandId, handler);
  }

  async executeCommand(commandId: string, ...args: any[]) {
    const handler = this.commands.get(commandId);
    if (!handler) {
      throw new Error(`Command ${commandId} not found`);
    }
    return await handler(...args);
  }

  // Getters for mocks
  get window() { return this.mockWindow; }
  get client() { return this.mockClient; }
  get ide() { return this.mockIDE; }
  get configHandler() { return this.mockConfigHandler; }
}

/**
 * Test Assertion Helpers
 */
export class E2eCommandAssertions {
  static assertCommandSuccess(result: any) {
    expect(result).toBeDefined();
    // Command completed without throwing
  }

  static assertInputBoxCalled(mockWindow: MockVSCodeWindow, expectedPrompt: string) {
    expect(mockWindow.showInputBox).toHaveBeenCalledWith(
      expect.objectContaining({ prompt: expectedPrompt })
    );
  }

  static assertInformationMessage(mockWindow: MockVSCodeWindow, expectedMessage: string) {
    expect(mockWindow.showInformationMessage).toHaveBeenCalledWith(
      expect.stringContaining(expectedMessage)
    );
  }

  static assertErrorMessage(mockWindow: MockVSCodeWindow, expectedMessage: string) {
    expect(mockWindow.showErrorMessage).toHaveBeenCalledWith(
      expect.stringContaining(expectedMessage)
    );
  }

  static assertWarningMessage(mockWindow: MockVSCodeWindow, expectedMessage: string) {
    expect(mockWindow.showWarningMessage).toHaveBeenCalledWith(
      expect.stringContaining(expectedMessage)
    );
  }

  static assertClientMethodCalled(client: MockDebuggAIServerClient, method: string, times: number = 1) {
    const clientMethod = method.split('.').reduce((obj, key) => obj[key], client as any);
    expect(clientMethod).toHaveBeenCalledTimes(times);
  }
}

/**
 * Test Data Factories
 */
export class TestDataFactory {
  static createMockE2eTest(overrides: Partial<MockE2eTest> = {}): MockE2eTest {
    return {
      uuid: `test-${Date.now()}`,
      description: 'Mock E2E Test',
      status: 'completed',
      runStatus: 'completed',
      testScript: 'https://mock-server.com/test-script.js',
      ...overrides
    };
  }

  static createMockE2eTestSuite(overrides: Partial<MockE2eTestSuite> = {}): MockE2eTestSuite {
    return {
      uuid: `suite-${Date.now()}`,
      name: 'Mock Test Suite',
      description: 'Mock Test Suite Description',
      status: 'completed',
      runStatus: 'completed',
      tests: [],
      ...overrides
    };
  }

  static createMockE2eCommitSuite(overrides: Partial<MockE2eTestCommitSuite> = {}): MockE2eCommitSuite {
    return {
      uuid: `commit-suite-${Date.now()}`,
      description: 'Mock Commit Suite',
      runStatus: 'completed',
      tests: [],
      ...overrides
    };
  }

  static createWorkingChanges() {
    return {
      workingChanges: {
        changes: [
          {
            type: 'modified',
            path: '/mock/workspace/src/components/Login.tsx',
            content: '// Modified login component'
          },
          {
            type: 'added',
            path: '/mock/workspace/src/utils/auth.ts',
            content: '// New auth utility'
          }
        ]
      },
      branchInfo: {
        branch: 'feature/new-auth',
        commitHash: 'abc123def456'
      }
    };
  }
}

/**
 * Setup function for tests
 */
export function setupE2eCommandTests() {
  const executor = new TestCommandExecutor();
  
  // Mock globals
  global.fetch = jest.fn().mockResolvedValue({
    text: () => Promise.resolve('// Mock test script content'),
    ok: true
  });

  // Mock VS Code
  jest.mock('vscode', () => ({
    window: executor.window,
    commands: {
      executeCommand: jest.fn()
    },
    Uri: {
      file: jest.fn((path: string) => ({ fsPath: path }))
    },
    workspace: {
      workspaceFolders: [{ uri: { fsPath: '/mock/workspace' } }]
    }
  }));

  return executor;
}

/**
 * Cleanup function for tests
 */
export function cleanupE2eCommandTests() {
  jest.clearAllMocks();
  jest.resetModules();
}