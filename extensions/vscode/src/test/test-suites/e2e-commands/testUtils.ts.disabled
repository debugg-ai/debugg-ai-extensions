export interface MockE2eTest extends E2eTest {
  uuid: string;
  description: string;
  status: string;
  runStatus: string;
  testScript?: string;
}

export interface MockE2eTestSuite extends E2eTestSuite {
  uuid: string;
  name: string;
  description: string;
  status: string;
  runStatus: string;
  tests?: MockE2eTest[];
}

export interface MockE2eTestCommitSuite extends E2eTestCommitSuite {
